# ==============================================================================
# JETFOOD POLMAN — Environment Variables Configuration
# ==============================================================================
# CATATAN:
# 1. Jangan pernah commit file `.env.local` atau `.env` yang berisi kredensial asli!
# 2. Nilai dengan awalan NEXT_PUBLIC_ dapat diakses di browser (client-side).
# 3. Kredensial rahasia (seperti SUPABASE_SERVICE_ROLE_KEY) hanya boleh diakses server-side.
# ==============================================================================

# Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret Key (ADMIN ONLY - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Timezone (Sulawesi Barat / Polman uses WITA = Asia/Makassar)
NEXT_PUBLIC_TIMEZONE=Asia/Makassar

# Indonesia Region API Base URL (digunakan untuk cascade wilayah Provinsi -> Kab -> Kec -> Desa)
NEXT_PUBLIC_REGION_API_BASE_URL=https://emsifa.github.io/api-wilayah-indonesia/api
