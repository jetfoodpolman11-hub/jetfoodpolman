# ==============================================================================
# JETFOOD POLMAN — Environment Variables Configuration
# ==============================================================================
# CATATAN KEAMANAN & PRODUKSI:
# 1. Jangan pernah commit file `.env.local` atau `.env` yang berisi kredensial asli!
# 2. Nilai dengan awalan NEXT_PUBLIC_ dapat diakses di browser (client-side).
# 3. Kredensial rahasia (SUPABASE_SERVICE_ROLE_KEY & SESSION_SECRET) HANYA boleh
#    diakses di server-side dan TIDAK BOLEH diawali NEXT_PUBLIC_.
# ==============================================================================

# 1. Supabase Public Configuration (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Server-Only Secret Key (ADMIN ONLY - DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Server-Only HMAC Session Signing Secret (Generate via: openssl rand -hex 32)
SESSION_SECRET=your-64-char-random-hmac-session-secret-here

# 4. Application Base URL & Operational Timezone (Polewali Mandar = WITA / UTC+8)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Makassar

# 5. Indonesia Region API Base URL (Digunakan untuk integrasi wilayah)
NEXT_PUBLIC_REGION_API_BASE_URL=https://emsifa.github.io/api-wilayah-indonesia/api
